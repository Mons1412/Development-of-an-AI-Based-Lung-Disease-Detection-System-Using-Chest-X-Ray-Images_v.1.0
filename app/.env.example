APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
MODEL_DIR=artifacts/lung_classifier/1.1.0
MAX_UPLOAD_MB=10
ENABLE_DEMO_UI=true
API_KEY_ENABLED=false
API_KEY_VALUE=
LOG_LEVEL=INFO

# Backward-compatible names used by the current FastAPI config.
HOST=127.0.0.1
PORT=8000
ARTIFACT_DIR=artifacts/lung_classifier/1.1.0
KNOWLEDGE_BASE_PATH=knowledge_base/compiled/knowledge_base.production.vi.json
# Local-only Phase 3 history storage. These paths contain no original uploads.
HISTORY_DB_PATH=var/data/lung_xray_history.db
THUMBNAIL_DIR=var/data/thumbnails
THUMBNAIL_MAX_DIMENSION=512
HISTORY_PAGE_SIZE=25
HISTORY_BUSY_TIMEOUT_MS=5000
API_KEY=

# Optional Gemini online assistant. Keep this disabled unless a local .env has
# a newly created, unexposed GEMINI_API_KEY. Never commit or package that file.
ONLINE_AI_ENABLED=false
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ONLINE_AI_TIMEOUT_SECONDS=30
ONLINE_AI_TEMPERATURE=
ONLINE_AI_MAX_ANSWER_CHARACTERS=6000
AI_OFFLINE_FALLBACK_ENABLED=true
